    "import tensorflow_datasets as tfds\n",
    "\n",
    "imdb_train = tfds.load(\n",
    "    \"imdb_reviews\",\n",
    "    split=\"train\",\n",
    "    as_supervised=True,\n",
    "    batch_size=2,\n",
    ")\n",
    "# Drop labels.\n",
    "imdb_train = imdb_train.map(lambda x, y: x)\n",
    "\n",
    "imdb_train.unbatch().take(1).get_single_element().numpy()"
   ]
