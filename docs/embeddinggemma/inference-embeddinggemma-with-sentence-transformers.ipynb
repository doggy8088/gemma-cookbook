   "source": [
    "# The sentences to encode\n",
    "sentence_high = [\n",
    "    \"The chef prepared a delicious meal for the guests.\",\n",
    "    \"A tasty dinner was cooked by the chef for the visitors.\"\n",
    "]\n",
