    "id": "JYq4z39uu-1a"
   },
   "source": [
    "## 安裝 Python 軟體包\n",
    "\n",
    "安裝執行 Gemma 模型和發出請求所需的 Hugging Face 庫。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d03cd6aa",
   "metadata": {
    "id": "BKczkppWvBAD"
   },
   "outputs": [],
   "source": [
    "# Install PyTorch & other libraries\n",
    "!pip install torch accelerate\n",
    "\n",
    "# Install the transformers library\n",
    "!pip install transformers"
   ]
  },
  {
   "attachments": {},
