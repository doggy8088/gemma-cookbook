   "source": [
    "MODEL_ID = \"google/gemma-4-E2B-it\" # @param [\"google/gemma-4-E2B-it\",\"google/gemma-4-E4B-it\", \"google/gemma-4-31B-it\", \"google/gemma-4-26B-A4B-it\"]\n",
    "\n",
    "from transformers import pipeline\n",
    "\n",
    "txt_pipe = pipeline(\n",
    "    task=\"text-generation\",\n",
    "    model=MODEL_ID,\n",
    "    device_map=\"auto\",\n",
    "    dtype=\"auto\"\n",
    ")"
   ]
