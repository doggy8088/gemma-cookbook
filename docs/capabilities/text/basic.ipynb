      "source": [
        "# Gemma Basic Text Inference"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "108ef8cf"
      },
      "source": [
        "<table class=\"tfo-notebook-buttons\" align=\"left\">\n",
