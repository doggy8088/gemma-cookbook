   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {
    "id": "60KmTK7o6ppd"
   },
   "source": [
    "<table class=\"tfo-notebook-buttons\" align=\"left\"> <td>    <a target=\"_blank\" href=\"https://ai.google.dev/gemma/docs/recurrentgemma/recurrentgemma_jax_inference\"><img src=\"https://ai.google.dev/static/site-assets/images/docs/notebook-site-button.png\" height=\"32\" width=\"32\" />View on ai.google.dev</a>\n",
