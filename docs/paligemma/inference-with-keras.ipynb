    "prompt = 'segment cat\\n'\n",
    "output = paligemma.generate(\n",
    "    inputs={\n",
    "        \"images\": cat,\n",
    "        \"prompts\": prompt,\n",
    "    }\n",
    ")"
   ]
  },
