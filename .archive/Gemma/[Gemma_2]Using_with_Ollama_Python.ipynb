    "nest_asyncio.apply()\n",
    "\n",
    "\n",
    "async def generate():\n",
    "    \"\"\"\n",
    "    Asynchronously generates a response to a given prompt using the AsyncClient.\n",
    "\n",
    "    This function creates an instance of AsyncClient and sends a request to generate\n",
