    "# Assume gemma2_llm is your initialized Gemma 9b model\n",
    "result = lf.query(\n",
    "    prompt=format_gemma_prompt(question),\n",
    "    schema=Solution,\n",
    "    lm=lf.llms.LlamaCppRemote(\"http://0.0.0.0:8000\")\n",
    ")\n",
    "print(result)"
