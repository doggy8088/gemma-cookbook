   },
   "outputs": [],
   "source": [
    "from huggingface_hub import hf_hub_download\n",
    "\n",
    "# Specify the repository and filename\n",
    "repo_id = 'google/gemma-2-2b-GGUF'  # Repository containing the GGUF model\n",
    "filename = '2b_pt_v2.gguf'  # The GGUF model file\n",
